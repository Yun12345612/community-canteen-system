
/* --- 全局容器 --- */
.page-container.data-v-d0592e28 {
  width: 100%;
  min-height: 100vh;
  background-color: #f8fafc; /* 清新浅灰白背景 */
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

/* --- 分类导航栏 --- */
.category-wrapper.data-v-d0592e28 {
  background: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.02);
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1rpx solid #f1f5f9;
}
.category-scroll.data-v-d0592e28 {
  height: 96rpx;
}
.category-list.data-v-d0592e28 {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-sizing: border-box;
  gap: 10rpx;
}
.category-item.data-v-d0592e28 {
  padding: 0 28rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 30rpx;
  color: #64748b;
  white-space: nowrap;
  position: relative;
  transition: all 0.3s ease;
  font-weight: 500;
}

/* 选中态：保持品牌绿 */
.category-item.active.data-v-d0592e28 {
  color: #10b981;
  font-weight: 700;
  transform: scale(1.05);
}
.category-item.active.data-v-d0592e28::after {
  content: "";
  position: absolute;
  bottom: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #10b981, #34d399);
  border-radius: 3rpx;
  box-shadow: 0 2rpx 8rpx rgba(16, 185, 129, 0.4);
}

/* --- 菜品列表区域 --- */
.dish-list-wrapper.data-v-d0592e28 {
  padding: 24rpx;
  box-sizing: border-box;
}
.dish-card.data-v-d0592e28 {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid rgba(255,255,255,0.6);
  transition: transform 0.2s, box-shadow 0.2s;
}
.dish-card.data-v-d0592e28:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.02);
}
.dish-img.data-v-d0592e28 {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  object-fit: cover;
  flex-shrink: 0;
  background-color: #f1f5f9;
  border: 1rpx solid #e2e8f0;
}
.dish-info.data-v-d0592e28 {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
}
.dish-name.data-v-d0592e28 {
  font-size: 32rpx;
  color: #1e293b;
  font-weight: 700;
  margin-bottom: 8rpx;
  line-height: 1.3;
}
.dish-desc.data-v-d0592e28 {
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
}
.dish-price.data-v-d0592e28 {
  font-size: 34rpx;
  color: #ff5000; /* 价格暖色强调 */
  font-weight: 800;
  margin-bottom: 12rpx;
  font-family: DIN, 'Helvetica Neue', Helvetica, Arial, sans-serif;
}
.dish-price.data-v-d0592e28::before {
  content: '￥';
  font-size: 24rpx;
  margin-right: 4rpx;
  font-weight: 600;
}
.dish-status.data-v-d0592e28 {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  width: -webkit-fit-content;
  width: fit-content;
}

/* 状态标签：保持绿色系 */
.status-on.data-v-d0592e28 {
  color: #10b981;
  background-color: #ecfdf5;
  border: 1rpx solid #a7f3d0;
}
.status-off.data-v-d0592e28 {
  color: #94a3b8;
  background-color: #f1f5f9;
  border: 1rpx solid #e2e8f0;
}

/* --- 加入购物车按钮：已改为暖橙色渐变 --- */
.add-cart-btn.data-v-d0592e28 {
  width: 170rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  font-weight: 600;
  /* 暖橙色渐变，刺激购买 */
  background: linear-gradient(135deg, #ff7b00 0%, #ff9100 100%);
  color: #fff;
  border: none;
  border-radius: 32rpx;
  flex-shrink: 0;
  padding: 0;
  box-shadow: 0 6rpx 16rpx rgba(255, 123, 0, 0.3);
  transition: all 0.2s;
  margin-left: 10rpx;
}
.add-cart-btn.data-v-d0592e28:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(255, 123, 0, 0.2);
}
.btn-hover.data-v-d0592e28 {
  opacity: 1;
}

/* --- 空状态 --- */
.empty-state.data-v-d0592e28 {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
  color: #94a3b8;
}
.empty-icon.data-v-d0592e28 {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.8;
  filter: grayscale(0.2);
}
.empty-text.data-v-d0592e28 {
  font-size: 30rpx;
  font-weight: 500;
}

/* --- 悬浮购物车按钮--- */
.cart-float.data-v-d0592e28 {
  position: fixed;
  right: 30rpx;
  bottom: 140rpx;
  width: 100rpx;
  height: 100rpx;
  /* 暖橙色渐变球体 */
  background: linear-gradient(135deg, #ff6a00 0%, #ff9500 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  box-shadow: 0 8rpx 24rpx rgba(255, 149, 0, 0.4);
  transition: transform 0.2s;
  border: 2rpx solid rgba(255,255,255,0.2);
}
.cart-float.data-v-d0592e28:active {
  transform: scale(0.9);
}
.cart-hover.data-v-d0592e28 {
  transform: scale(0.9);
  opacity: 1;
}
.cart-icon.data-v-d0592e28 {
  color: #fff;
  font-size: 48rpx;
  margin-top: -4rpx;
}
.cart-badge.data-v-d0592e28 {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 40rpx;
  height: 40rpx;
  background: #ef4444;
  color: #fff;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  line-height: 40rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border: 2rpx solid #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(239, 68, 68, 0.4);
}
@keyframes popIn-d0592e28 {
from { transform: scale(0); opacity: 0;
}
to { transform: scale(1); opacity: 1;
}
}
.cart-badge.data-v-d0592e28 {
  animation: popIn-d0592e28 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
