<view wx:if="{{a}}" class="dish-detail-container data-v-de90b20a"><view class="dish-base-info data-v-de90b20a"><image class="dish-big-img data-v-de90b20a" src="{{b}}" mode="aspectFill" binderror="{{c}}"></image><view class="dish-base-content data-v-de90b20a"><text class="dish-title data-v-de90b20a">{{d}}</text><text class="dish-price data-v-de90b20a">¥{{e}}</text><text class="dish-desc data-v-de90b20a">{{f}}</text><view class="action-btns data-v-de90b20a"><button wx:if="{{g}}" class="add-cart-btn data-v-de90b20a" bindtap="{{h}}" hover-class="btn-hover">加入购物车</button></view><text wx:if="{{i}}" class="stock-tips data-v-de90b20a"> 菜品已下架 </text><text wx:elif="{{j}}" class="stock-tips data-v-de90b20a"> 库存不足 </text></view></view><view wx:if="{{k}}" class="related-recommend data-v-de90b20a"><text class="related-title data-v-de90b20a">搭配推荐</text><scroll-view class="related-scroll data-v-de90b20a" scroll-x="true" show-scrollbar="false"><view class="related-list data-v-de90b20a"><view wx:for="{{l}}" wx:for-item="item" wx:key="e" class="related-item data-v-de90b20a" bindtap="{{item.f}}"><image class="related-img data-v-de90b20a" src="{{item.a}}" mode="aspectFill" binderror="{{item.b}}"></image><text class="related-name data-v-de90b20a">{{item.c}}</text><text class="related-price data-v-de90b20a">¥{{item.d}}</text></view></view></scroll-view></view><view wx:if="{{m}}" class="related-empty data-v-de90b20a"><text class="empty-text data-v-de90b20a">暂无搭配推荐</text></view></view><view wx:else class="empty-container data-v-de90b20a"><text class="empty-text data-v-de90b20a">{{n}}</text></view>