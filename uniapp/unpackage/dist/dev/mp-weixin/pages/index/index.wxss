
.index-container.data-v-1cf27b2a {
  padding: 20rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
  box-sizing: border-box;
  /* 底部留50px空间给导航栏，避免内容被遮挡 */
  padding-bottom: 50px;
}
.banner-card.data-v-1cf27b2a {
  background: linear-gradient(135deg, #07c160, #02a850);
  border-radius: 24rpx;
  padding: 50rpx 32rpx;
  color: #fff;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.15);
}
.banner-main.data-v-1cf27b2a {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 12rpx;
}
.banner-sub.data-v-1cf27b2a {
  font-size: 26rpx;
  opacity: 0.9;
}
.func-grid.data-v-1cf27b2a {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}
.func-item.data-v-1cf27b2a {
  flex: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  transition: all 0.2s;
}
.item-hover.data-v-1cf27b2a {
  transform: scale(0.98);
  opacity: 0.9;
}
.func-icon.data-v-1cf27b2a {
  font-size: 56rpx;
  display: block;
  margin-bottom: 16rpx;
}
.func-text.data-v-1cf27b2a {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}
.notice-card.data-v-1cf27b2a {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 32rpx;
}
.notice-header.data-v-1cf27b2a {
  margin-bottom: 20rpx;
}
.notice-title.data-v-1cf27b2a {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}
.notice-list.data-v-1cf27b2a {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.notice-item.data-v-1cf27b2a {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}
.recommend-card.data-v-1cf27b2a {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.recommend-header.data-v-1cf27b2a {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.recommend-title.data-v-1cf27b2a {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}
.recommend-more.data-v-1cf27b2a {
  font-size: 24rpx;
  color: #ff6700;
}
.recommend-scroll.data-v-1cf27b2a {
  white-space: nowrap;
}
.recommend-list.data-v-1cf27b2a {
  display: flex;
  gap: 20rpx;
  padding-bottom: 10rpx;
  min-height: 220rpx;
}
.recommend-item.data-v-1cf27b2a {
  width: 180rpx;
  text-align: center;
  flex-shrink: 0;
}
.recommend-img.data-v-1cf27b2a {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background-color: #f2f2f2;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.recommend-name.data-v-1cf27b2a {
  font-size: 26rpx;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.recommend-price.data-v-1cf27b2a {
  font-size: 28rpx;
  color: #ff6700;
  font-weight: bold;
}
.recommend-empty.data-v-1cf27b2a {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  text-align: center;
  margin-bottom: 32rpx;
}
.empty-text.data-v-1cf27b2a {
  font-size: 28rpx;
  color: #999;
}
