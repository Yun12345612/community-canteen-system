
/* --- 全局容器 --- */
.mine-container.data-v-7c2ebfa5 {
  min-height: 100vh;
  background-color: #f8fafc; /* 统一浅灰白背景 */
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* --- 用户卡片：调整为登录页同款绿色渐变 --- */
.user-card.data-v-7c2ebfa5 {
  /* 使用登录页同款绿色渐变 #07c160 -> #02b454 */
  background: linear-gradient(135deg, #07c160 0%, #02b454 100%);
  padding: 90rpx 40rpx 50rpx;
  border-radius: 0 0 40rpx 40rpx;
  display: flex;
  align-items: center;
  /* 阴影颜色同步 */
  box-shadow: 0 12rpx 32rpx rgba(7, 193, 96, 0.25);
  margin-bottom: 40rpx;
  position: relative;
  overflow: hidden;
}

/* 增加一点装饰性光晕 */
.user-card.data-v-7c2ebfa5::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 60%);
  pointer-events: none;
}
.avatar-wrapper.data-v-7c2ebfa5 {
  position: relative;
  margin-right: 40rpx;
  z-index: 2;
}
.avatar.data-v-7c2ebfa5 {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.5);
  object-fit: cover;
  background: #fff;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.1);
}
.edit-tag.data-v-7c2ebfa5 {
  position: absolute;
  bottom: 4rpx;
  right: -4rpx;
  background-color: #ffffff;
  /* 文字颜色使用登录页同款绿色 */
  color: #07c160;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
  white-space: nowrap;
}
.user-info.data-v-7c2ebfa5 {
  flex: 1;
  color: #fff;
  z-index: 2;
}
.nickname.data-v-7c2ebfa5 {
  font-size: 42rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}
.signature.data-v-7c2ebfa5 {
  font-size: 28rpx;
  opacity: 0.95;
  display: flex;
  align-items: center;
  gap: 12rpx;
  max-width: 90%;
}
.pen-icon.data-v-7c2ebfa5 {
  font-size: 24rpx;
  opacity: 0.8;
}

/* --- 菜单列表 --- */
.menu-wrapper.data-v-7c2ebfa5 {
  padding: 0 30rpx;
}
.menu-group.data-v-7c2ebfa5 {
  background-color: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid rgba(255,255,255,0.6);
}
.menu-item.data-v-7c2ebfa5 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 36rpx 32rpx;
  transition: background-color 0.2s;
}
.item-active.data-v-7c2ebfa5 {
  background-color: #f1f5f9;
}
.divider.data-v-7c2ebfa5 {
  border-bottom: 1rpx solid #f1f5f9;
}
.menu-left.data-v-7c2ebfa5 {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.menu-icon.data-v-7c2ebfa5 {
  font-size: 36rpx;
  width: 48rpx;
  text-align: center;
}
.menu-title.data-v-7c2ebfa5 {
  font-size: 32rpx;
  color: #1e293b;
  font-weight: 600;
}
.menu-right.data-v-7c2ebfa5 {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.menu-value.data-v-7c2ebfa5 {
  font-size: 28rpx;
  color: #94a3b8;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.arrow.data-v-7c2ebfa5 {
  font-size: 32rpx;
  color: #cbd5e1;
  font-weight: bold;
}

/* --- 退出登录按钮：保持红色警示色 --- */
.logout-btn.data-v-7c2ebfa5 {
  margin: 80rpx 40rpx 0;
  height: 88rpx;
  background-color: #fff;
  border: 2rpx solid #ef4444;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(239, 68, 68, 0.1);
}
.logout-active.data-v-7c2ebfa5 {
  transform: scale(0.98);
  background-color: #fef2f2;
}
.logout-text.data-v-7c2ebfa5 {
  color: #ef4444;
  font-size: 32rpx;
  font-weight: 600;
}

/* --- 弹窗样式 --- */
.popup-content.data-v-7c2ebfa5 {
  width: 620rpx;
  padding: 50rpx 40rpx;
  background-color: #fff;
  border-radius: 30rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
  text-align: center;
}
.popup-title.data-v-7c2ebfa5 {
  font-size: 36rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 40rpx;
}
.popup-input.data-v-7c2ebfa5, .popup-textarea.data-v-7c2ebfa5 {
  width: 100%;
  padding: 24rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  margin-bottom: 50rpx;
  background: #f8fafc;
  color: #333;
}
.popup-input.data-v-7c2ebfa5:focus, .popup-textarea.data-v-7c2ebfa5:focus {
  /* 聚焦边框颜色使用登录页同款绿色 */
  border-color: #07c160;
  background: #fff;
}
.popup-textarea.data-v-7c2ebfa5 {
  min-height: 160rpx;
  resize: none;
}
.popup-btns.data-v-7c2ebfa5 {
  display: flex;
  gap: 32rpx;
}
.popup-btn.data-v-7c2ebfa5 {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cancel.data-v-7c2ebfa5 {
  background-color: #f1f5f9;
  color: #64748b;
}

/* 登录页同款绿色渐变 */
.confirm.data-v-7c2ebfa5 {
  /* 使用登录页同款绿色渐变 */
  background: linear-gradient(135deg, #07c160 0%, #02b454 100%);
  color: #fff;
  /* 阴影颜色同步 */
  box-shadow: 0 6rpx 16rpx rgba(7, 193, 96, 0.3);
}
.confirm.data-v-7c2ebfa5:active {
  transform: scale(0.96);
}
