
/* 原有样式不变，新增“去评价”按钮样式 */
.order-container.data-v-456ecf67 {
  padding: 20rpx;
  min-height: 100vh;
  background: #f7f8fa;
  box-sizing: border-box;
  /* 增加底部内边距，避免内容被导航栏遮挡 */
  padding-bottom: 60rpx;
}

/* 空订单样式 */
.empty-box.data-v-456ecf67 {
  text-align: center;
  padding-top: 150rpx;
}
.empty-icon.data-v-456ecf67 {
  font-size: 110rpx;
  display: block;
  margin-bottom: 24rpx;
  color: #ccc;
}
.empty-text.data-v-456ecf67 {
  font-size: 28rpx;
  color: #999;
  display: block;
  margin-bottom: 48rpx;
}
.goto-btn.data-v-456ecf67 {
  width: 260rpx;
  height: 76rpx;
  background: #ff6700;
  color: #fff;
  border: none;
  border-radius: 38rpx;
  font-size: 28rpx;
}

/* 加载中 */
.loading-box.data-v-456ecf67 {
  text-align: center;
  padding: 100rpx 0;
}
.loading-text.data-v-456ecf67 {
  font-size: 28rpx;
  color: #999;
}

/* 订单列表 */
.order-list.data-v-456ecf67 {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.order-item.data-v-456ecf67 {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 订单头部 */
.order-header.data-v-456ecf67 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f2f2f2;
}
.order-no.data-v-456ecf67 {
  font-size: 26rpx;
  color: #666;
}
.status-group.data-v-456ecf67 {
  display: flex;
  gap: 10rpx;
  align-items: center;
}
.pay-status.data-v-456ecf67 {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  color: #fff;
}
.pay-wait.data-v-456ecf67 { background: #ff3b30;
}
.pay-success.data-v-456ecf67 { background: #07c160;
}
.pay-refund.data-v-456ecf67 { background: #999;
}
.order-status.data-v-456ecf67 {
  font-size: 26rpx;
  font-weight: bold;
}
.order-wait.data-v-456ecf67 { color: #ff9500;
}
.order-processing.data-v-456ecf67 { color: #0088ff;
}
.order-success.data-v-456ecf67 { color: #07c160;
}
.order-cancel.data-v-456ecf67 { color: #999;
}

/* 订单信息 */
.order-info.data-v-456ecf67 {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.info-item.data-v-456ecf67 {
  display: flex;
  font-size: 28rpx;
}
.label.data-v-456ecf67 {
  color: #999;
  width: 120rpx;
}
.value.data-v-456ecf67 {
  color: #333;
  flex: 1;
}

/* 订单金额 */
.order-amount.data-v-456ecf67 {
  padding-top: 20rpx;
  border-top: 1rpx solid #f2f2f2;
}
.amount-text.data-v-456ecf67 {
  font-size: 30rpx;
  color: #ff6700;
  font-weight: bold;
}

/* 订单操作按钮 */
.order-actions.data-v-456ecf67 {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}
.action-btn.data-v-456ecf67 {
  flex: 1;
  height: 70rpx;
  border: none;
  border-radius: 35rpx;
  font-size: 26rpx;
}
.pay-btn.data-v-456ecf67 {
  background: #07c160;
  color: #fff;
}
.cancel-btn.data-v-456ecf67 {
  background: #f5f5f5;
  color: #666;
}
/* 去评价按钮样式 */
.evaluate-btn.data-v-456ecf67 {
  background: #ff6700;
  color: #fff;
}
.evaluate-btn.evaluated.data-v-456ecf67 {
  background: #07c160;
  color: #fff;
}
.evaluate-btn.data-v-456ecf67:disabled {
  background: #ccc;
  color: #fff;
}
/* 菜品评价按钮样式 */
.dish-eval-btn.data-v-456ecf67 {
  background: #667eea;
  color: #fff;
}

/* 状态提示文字 */
.status-tip.data-v-456ecf67 {
  font-size: 26rpx;
  color: #999;
  line-height: 70rpx;
}
.status-tip.cancelled.data-v-456ecf67 {
  color: #999;
}
.btn-hover.data-v-456ecf67 {
  opacity: 0.9;
  transform: scale(0.98);
}
