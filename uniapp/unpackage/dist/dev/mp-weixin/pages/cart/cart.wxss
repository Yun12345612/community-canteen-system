
/* --- 全局容器 --- */
.cart-container.data-v-c91e7611 {
  padding: 24rpx;
  background: #f8fafc; /* 浅灰白背景 */
  min-height: 100vh;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

/* --- 空状态优化 --- */
.empty-box.data-v-c91e7611 {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  animation: fadeIn-c91e7611 0.5s ease;
}
.empty-icon.data-v-c91e7611 {
  font-size: 120rpx;
  display: block;
  margin-bottom: 30rpx;
  /* 使用登录页同款绿色 #07c160 */
  color: #07c160; 
  filter: drop-shadow(0 10rpx 20rpx rgba(7, 193, 96, 0.2));
  transition: transform 0.3s;
}
.empty-text.data-v-c91e7611 {
  font-size: 30rpx;
  color: #64748b;
  display: block;
  margin-bottom: 60rpx;
  letter-spacing: 1rpx;
  font-weight: 400;
}
.goto-btn.data-v-c91e7611 {
  width: 280rpx;
  height: 80rpx;
  /*使用登录页同款绿色渐变 #07c160 -> #02b454 */
  background: linear-gradient(135deg, #07c160 0%, #02b454 100%);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  /* 阴影颜色同步 */
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.3);
  transition: transform 0.2s;
}
.goto-btn.data-v-c91e7611:active {
  transform: scale(0.95);
}

/* --- 列表项优化 --- */
.cart-item.data-v-c91e7611 {
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 20rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
  transition: transform 0.2s, box-shadow 0.2s;
}
.cart-item.data-v-c91e7611:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.02);
}
.item-img.data-v-c91e7611 {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  object-fit: cover;
  background: #f1f5f9;
  border: 1rpx solid #e2e8f0;
}
.item-info.data-v-c91e7611 {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
}
.name.data-v-c91e7611 {
  font-size: 32rpx;
  color: #1e293b;
  margin-bottom: 12rpx;
  font-weight: 600;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.price.data-v-c91e7611 {
  font-size: 34rpx;
  color: #ff5000; /* 价格保留暖色 */
  font-weight: 700;
  font-family: DIN, 'Helvetica Neue', Helvetica, Arial, sans-serif;
}
.price.data-v-c91e7611::before {
  content: '￥';
  font-size: 24rpx;
  margin-right: 4rpx;
  font-weight: 500;
}

/* --- 计数器优化 --- */
.count-box.data-v-c91e7611 {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #f1f5f9;
  padding: 8rpx;
  border-radius: 30rpx;
}
.count-btn.data-v-c91e7611 {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: #ffffff;
  border-radius: 50%;
  font-size: 32rpx;
  /* 按钮文字使用登录页同款绿色 */
  color: #07c160;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  transition: all 0.2s;
  -webkit-user-select: none;
          user-select: none;
}
.count-btn.data-v-c91e7611:active {
  /* 按下背景使用登录页同款深绿 */
  background: #07c160;
  color: #fff;
  transform: scale(0.9);
}
.count-num.data-v-c91e7611 {
  font-size: 30rpx;
  min-width: 48rpx;
  text-align: center;
  font-weight: 600;
  color: #1e293b;
}

/* --- 底部栏优化 --- */
.bottom-bar.data-v-c91e7611 {
  position: fixed;
  bottom: 30rpx;
  left: 24rpx;
  right: 24rpx;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.95);
  -webkit-backdrop-filter: blur(20rpx);
          backdrop-filter: blur(20rpx);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  border-radius: 50rpx;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.08);
  z-index: 999;
  box-sizing: border-box;
  border: 1rpx solid rgba(226, 232, 240, 0.6);
}
.total.data-v-c91e7611 {
  font-size: 36rpx;
  color: #1e293b;
  font-weight: 600;
}
.total.data-v-c91e7611::before {
  content: '合计：';
  font-size: 26rpx;
  color: #64748b;
  font-weight: 400;
  margin-right: 8rpx;
}
.settle-btn.data-v-c91e7611 {
  width: 220rpx;
  height: 72rpx;
  /* 结算按钮使用登录页同款绿色渐变 */
  background: linear-gradient(90deg, #07c160 0%, #02b454 100%);
  color: #fff;
  border: none;
  border-radius: 36rpx;
  font-size: 30rpx;
  font-weight: 600;
  /* 阴影颜色同步 */
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.4);
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-hover.data-v-c91e7611 {
  opacity: 1;
  transform: scale(0.96);
  box-shadow: 0 4rpx 10rpx rgba(7, 193, 96, 0.3);
}

/* 动画定义 */
@keyframes fadeIn-c91e7611 {
from { opacity: 0; transform: translateY(20rpx);
}
to { opacity: 1; transform: translateY(0);
}
}
