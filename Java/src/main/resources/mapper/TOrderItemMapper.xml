<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.canteen.communitycanteenosystem.mapper.TOrderItemMapper">
    <!-- 结果映射：数据库下划线 → 实体类驼峰 -->
    <resultMap id="BaseResultMap" type="com.canteen.communitycanteenosystem.entity.TOrderItem">
        <id column="id" property="id"/>
        <result column="order_id" property="orderId"/>
        <result column="dish_id" property="dishId"/>
        <result column="dish_name" property="dishName"/>
        <result column="unit_price" property="unitPrice"/>
        <result column="quantity" property="quantity"/>
        <result column="subtotal" property="subtotal"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <!-- 根据订单ID查询菜品明细 -->
    <select id="listByOrderId" resultMap="BaseResultMap">
        SELECT * FROM t_order_item WHERE order_id = #{orderId}
    </select>
</mapper>